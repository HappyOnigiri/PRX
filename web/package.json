{
  "name": "prx-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently --kill-others --names api,web --prefix-colors blue,magenta \"cd .. && go tool air -c .air.toml\" \"node scripts/wait-for-api.js && vite\"",
    "build": "tsc -b && vite build",
    "test": "vitest run --coverage",
    "lint": "pnpm run format:check && eslint . --max-warnings=0 && tsc -b --pretty false && pnpm run check:dead-code && pnpm run lint:css",
    "lint:css": "stylelint \"src/**/*.css\"",
    "check:dead-code": "knip --no-progress",
    "check:duplicates": "jscpd --min-lines 20 --min-tokens 60 --reporters console --exit-code 1 --no-colors --no-tips --format typescript,tsx --ignore 'src/gen/**' src",
    "format": "prettier --write src tests index.html *.ts *.json",
    "format:check": "prettier --check src tests index.html *.ts *.json",
    "e2e": "playwright test",
    "clean": "rm -rf coverage playwright-report test-results"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.9.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.1",
    "@tanstack/react-query": "^5.87.4",
    "@tanstack/react-router": "^1.131.35",
    "@xyflow/react": "^12.8.5",
    "elkjs": "^0.11.0",
    "i18next": "^26.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.12",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.9.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "10.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "jscpd": "^5.0.16",
    "jsdom": "^30.0.1",
    "knip": "^6.32.3",
    "prettier": "^3.6.2",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^39.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^4.1.11"
  }
}
